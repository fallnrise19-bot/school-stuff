@Composable
fun MockupArtImage(
    asset: MockupAsset,
    modifier: Modifier = Modifier,
    contentDescription: String? = null,
    contentScale: ContentScale = ContentScale.Fit
) {
    val image = remember(asset) {
        val raw = Base64.decode(mockupArtData.getValue(asset), Base64.DEFAULT)
        BitmapFactory.decodeByteArray(raw, 0, raw.size).asImageBitmap()
    }
    Image(bitmap = image, contentDescription = contentDescription, modifier = modifier, contentScale = contentScale)
}
